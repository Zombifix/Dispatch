# Copier en .env pour le développement local. Ne jamais committer .env.

# Obligatoire
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dispatch
SESSION_SECRET=remplacer-par-32-octets-aleatoires   # openssl rand -hex 32

# LLM (sans clé, les fonctions IA sont désactivées ; l'assemblage déterministe reste disponible)
OPENAI_API_KEY=
# Fournisseur compatible OpenAI optionnel (Scaleway, Mistral, OVH...). Vide = OpenAI.
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
WRITER_MODEL=gpt-4o
EVAL_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Optionnel
INVITE_CODE=
PORT=5000
# Nombre maximal d'appels LLM par utilisateur et par jour (0 = illimité)
LLM_DAILY_QUOTA=200
